# ==========================================
# Render Deployment Environment Variables
# ==========================================
# Add these in your Render Web Service settings under "Environment"

# ------------------------------------------
# Runtime (Required)
# ------------------------------------------
NODE_ENV=production

# ------------------------------------------
# Database Configuration (Required)
# ------------------------------------------
# Get these from your PostgreSQL provider (Render, Neon, Supabase, etc.)
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=attendance_db
DB_SSL=true

# ------------------------------------------
# CORS (Required for same-origin deployment)
# ------------------------------------------
# Use "*" to allow all origins (recommended for single-service deployment)
# Or specify your Render URL: https://your-app.onrender.com
CORS_ORIGIN=*

# ------------------------------------------
# Frontend API URL (Leave empty for same-origin)
# ------------------------------------------
# Since frontend and backend are served from the same URL,
# leave this EMPTY - the frontend will use relative URLs
VITE_API_URL=

## to start use pnpm dev

